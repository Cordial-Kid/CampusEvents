<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/event_admin_title" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/event_admin_hint" android:paddingTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/event_create" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/event_create" />
        <Button android:id="@+id/event_refresh" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/event_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/event_list_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/event_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
